"""Typings for queries generated by aiosql"""

from typing import Dict, Optional, Sequence, List, Any

from asyncpg import Connection, Record

class TransactionsQueriesMixin:
    async def check_transaction_exists(self, conn: Connection, **kwargs) -> Record: ...
    async def check_transaction_exists_cursor(
        self, conn: Connection, **kwargs
    ) -> Record: ...
    async def create_new_transaction(self, conn: Connection, **kwargs) -> Record: ...
    async def create_new_transaction_cursor(
        self, conn: Connection, **kwargs
    ) -> Record: ...
    async def create_transaction_strategy(
        self, conn: Connection, **kwargs
    ) -> Record: ...
    async def create_transaction_strategy_cursor(
        self, conn: Connection, **kwargs
    ) -> Record: ...
    async def get_transaction_strategies(
        self, conn: Connection, **kwargs
    ) -> Record: ...
    async def get_transaction_strategies_cursor(
        self, conn: Connection, **kwargs
    ) -> Record: ...

class StrategiesQueriesMixin:
    async def add_child_queries(self, conn: Connection, **kwargs) -> Record: ...
    async def add_queries(self, conn: Connection, **kwargs) -> Record: ...
    async def add_query(self, conn: Connection, **kwargs) -> Record: ...
    async def create_strategy(self, conn: Connection, **kwargs) -> Record: ...
    async def create_strategy_cursor(self, conn: Connection, **kwargs) -> Record: ...
    async def get_all_active_strategies(self, conn: Connection, **kwargs) -> Record: ...
    async def get_all_active_strategies_cursor(
        self, conn: Connection, **kwargs
    ) -> Record: ...
    async def get_strategy_by_type(self, conn: Connection, **kwargs) -> Record: ...
    async def get_strategies_by_type_cursor(
        self, conn: Connection, **kwargs
    ) -> Record: ...
    async def get_strategy_by_type_and_params(
        self, conn: Connection, **kwargs
    ) -> Record: ...
    async def get_strategy_by_type_and_params_cursor(
        self, conn: Connection, **kwargs
    ) -> Record: ...
    async def get_strategy_statistics(self, conn: Connection, **kwargs) -> Record: ...
    async def get_strategy_statistics_cursor(
        self, conn: Connection, **kwargs
    ) -> Record: ...
    async def load_from_list(self, conn: Connection, **kwargs) -> Record: ...
    async def load_from_tree(self, conn: Connection, **kwargs) -> Record: ...

class Queries(
    TransactionsQueriesMixin,
    StrategiesQueriesMixin,
): ...

queries: Queries
